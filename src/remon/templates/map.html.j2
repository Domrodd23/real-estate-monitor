<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>National map — real estate monitor</title>
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/pmtiles@3.2.1/dist/pmtiles.js"></script>
<style>
  :root { --accent:#1f6feb; --ink:#1b1f23; --muted:#5b6670; --line:#e3e7eb;
          --card:0 2px 10px rgba(0,0,0,.15); }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html, body { margin:0; height:100%; overflow:hidden; }
  body { color:var(--ink); background:#fff;
         font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

  /* ---- app shell: slim topbar + full-bleed map ---- */
  .topbar { position:fixed; top:0; left:0; right:0; height:48px; z-index:10;
            display:flex; align-items:center; gap:14px; padding:0 16px;
            background:#fff; border-bottom:1px solid var(--line); }
  .topbar h1 { font-size:1.05rem; margin:0; white-space:nowrap; }
  .topbar a { color:var(--accent); text-decoration:none; font-size:.88rem; white-space:nowrap; }
  .topbar a:hover { text-decoration:underline; }
  .topbar .gen { color:var(--muted); font-size:.78rem; margin-left:auto; }
  .reset { border:1px solid var(--line); background:#fff; color:#33404d; border-radius:7px;
           padding:5px 11px; font-size:.82rem; cursor:pointer; white-space:nowrap; }
  .reset:hover { border-color:var(--accent); color:var(--accent); }

  #map { position:fixed; top:48px; left:0; right:0; bottom:0; }
  .veil { position:fixed; top:48px; left:0; right:0; bottom:0; z-index:4;
          background:#f6f8fa; pointer-events:none; opacity:1; transition:opacity .5s; }

  /* ---- floating control card (search + chips + metric pills) ---- */
  .ctl-card { position:fixed; top:60px; left:12px; z-index:7; width:340px;
              max-width:calc(100vw - 24px); background:#fff; border-radius:10px;
              box-shadow:var(--card); padding:10px; }
  .searchwrap { position:relative; }
  #searchBox { width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:8px;
               font-size:.92rem; outline:none; }
  #searchBox:focus { border-color:var(--accent); box-shadow:0 0 0 2px rgba(31,111,235,.15); }
  .sresults { position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:7;
              background:#fff; border:1px solid var(--line); border-radius:8px;
              box-shadow:var(--card); list-style:none; margin:0; padding:4px;
              max-height:280px; overflow-y:auto; }
  .sresults li { padding:7px 10px; border-radius:6px; font-size:.88rem; cursor:pointer;
                 display:flex; justify-content:space-between; gap:8px; }
  .sresults li .sub { color:var(--muted); font-size:.78rem; }
  .sresults li.active, .sresults li:hover { background:#eef4ff; }
  .chips { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
  .chip { border:1px solid var(--line); background:#f6f8fa; color:#33404d; border-radius:999px;
          padding:4px 11px; font-size:.8rem; cursor:pointer; }
  .chip:hover { border-color:var(--accent); color:var(--accent); }
  .mgroups { margin-top:8px; max-height:calc(100vh - 330px); overflow-y:auto; }
  .mghead { width:100%; display:flex; justify-content:space-between; align-items:center;
            border:none; background:none; padding:8px 6px 4px; font-size:.74rem; font-weight:700;
            color:#33404d; cursor:pointer; text-transform:uppercase; letter-spacing:.04em; }
  .mghead .car { color:var(--muted); transition:transform .15s; }
  .mgroup.closed .mglist { display:none; }
  .mgroup.closed .car { transform:rotate(-90deg); }
  .mrow { display:flex; width:100%; align-items:center; gap:9px; border:none; background:none;
          padding:7px 8px; border-radius:7px; font-size:.87rem; color:#33404d;
          cursor:pointer; text-align:left; }
  .mrow:hover { background:#f0f4fa; color:var(--accent); }
  .mrow.active { background:var(--accent); color:#fff; font-weight:600; }
  .mrow .dot { width:8px; height:8px; border-radius:50%; border:2px solid #b6bfc9; flex:0 0 auto; }
  .mrow.active .dot { border-color:#fff; background:#fff; }

  /* ---- legend card ---- */
  .legend-card { position:fixed; bottom:26px; left:12px; z-index:5; width:300px;
                 max-width:calc(100vw - 24px); background:#fff; border-radius:10px;
                 box-shadow:var(--card); padding:10px 12px; font-size:.78rem; color:var(--muted); }
  .lhead { display:flex; align-items:center; justify-content:space-between; gap:6px; }
  .lt { font-weight:600; color:#33404d; font-size:.85rem; }
  .ltag { margin-left:auto; font-size:.68rem; color:var(--muted); background:#f0f2f4;
          border-radius:999px; padding:2px 8px; white-space:nowrap; }
  .ltag:empty { display:none; }
  .ibtn { border:none; background:none; color:var(--muted); font-size:.95rem; cursor:pointer;
          padding:2px 4px; border-radius:5px; }
  .ibtn:hover { color:var(--accent); background:#eef4ff; }
  .ldesc { margin-top:2px; line-height:1.35; }
  .lrow { display:flex; align-items:center; gap:8px; margin-top:7px; }
  .lv { font-variant-numeric:tabular-nums; white-space:nowrap; }
  .lbar { position:relative; flex:1; height:12px; border-radius:7px;
          border:1px solid rgba(0,0,0,0.12); }
  .ltick { display:none; position:absolute; top:-4px; bottom:-4px; width:2px;
           background:#1b1f23; border-radius:1px; transition:left .06s linear; }
  .lzones { position:absolute; inset:-6px 0; display:flex; }
  .lzones button { flex:1; cursor:pointer; background:none; border:none; padding:0; }
  .lzones button:hover { background:rgba(255,255,255,.35); }
  .lzones button.on { outline:2px solid var(--accent); outline-offset:-2px; border-radius:4px; }
  .lfoot { display:flex; align-items:center; justify-content:space-between; margin-top:7px; }
  .lna i { display:inline-block; width:12px; height:12px; background:#d4d4d4; border-radius:3px;
           border:1px solid rgba(0,0,0,0.12); vertical-align:-2px; margin-right:4px; }
  .rchip { border:1px solid var(--accent); background:#eef4ff; color:var(--accent);
           border-radius:999px; padding:2px 9px; font-size:.75rem; cursor:pointer; }
  .infopop { position:absolute; bottom:calc(100% + 8px); left:0; width:290px;
             background:#fff; border-radius:10px; box-shadow:var(--card); padding:10px 12px;
             line-height:1.45; z-index:8; }

  /* ---- stats panel (desktop card / mobile bottom sheet) ---- */
  .panel { position:fixed; top:60px; right:12px; z-index:6; width:300px;
           max-height:calc(100vh - 140px); overflow-y:auto; background:#fff;
           border-radius:10px; box-shadow:var(--card);
           opacity:0; transform:translateX(12px); pointer-events:none; visibility:hidden;
           transition:opacity .25s ease, transform .25s ease, visibility .25s; }
  .panel.open { opacity:1; transform:none; pointer-events:auto; visibility:visible; }
  .phead { display:flex; align-items:flex-start; justify-content:space-between;
           padding:12px 14px 8px; }
  .phead h2 { font-size:1rem; margin:0; line-height:1.3; }
  .badge { display:inline-block; margin-top:4px; background:#1b1f23; color:#fff;
           font-size:.66rem; font-weight:700; letter-spacing:.06em; border-radius:4px;
           padding:2px 7px; }
  .pclose { border:none; background:none; color:var(--muted); font-size:1.05rem;
            cursor:pointer; padding:2px 6px; border-radius:6px; }
  .pclose:hover { color:var(--ink); background:#f0f2f4; }
  .prows { padding:0 14px 4px; }
  .prow { padding:7px 8px; border-radius:7px; margin:0 -8px; }
  .prow.active { background:#eef4ff; }
  .prow .plabel { display:block; color:var(--muted); font-size:.76rem; }
  .prow .pval { font-size:1.02rem; font-weight:600; font-variant-numeric:tabular-nums; }
  .prow .ppct { display:block; color:var(--muted); font-size:.74rem; margin-top:1px; }
  .pactions { display:flex; gap:8px; padding:8px 14px 14px; }
  .pbtn { flex:1; border:1px solid var(--line); background:#fff; color:#33404d;
          border-radius:8px; padding:8px 6px; font-size:.82rem; font-weight:500; cursor:pointer; }
  .pbtn:hover { border-color:var(--accent); color:var(--accent); }
  .pbtn.primary { background:var(--accent); border-color:var(--accent); color:#fff; }
  .pbtn.primary:hover { background:#175bc4; color:#fff; }

  /* ---- first-run coach mark ---- */
  .coach { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:6;
           background:rgba(27,31,35,.88); color:#fff; font-size:.9rem; border-radius:999px;
           padding:10px 18px; pointer-events:none; opacity:0; transition:opacity .6s;
           width:max-content; max-width:calc(100vw - 32px); text-align:center; }
  .coach.show { opacity:1; }

  .maplibregl-popup-content { font-size:12.5px; padding:8px 11px; border-radius:7px; }
  .tiprows { display:grid; grid-template-columns:auto auto; gap:2px 14px; margin-top:5px; }
  .tiprows b { text-align:right; font-variant-numeric:tabular-nums; }
  .tipmore { color:#8a949e; font-size:10.5px; margin-top:5px; }
  .pgroup { font-size:.68rem; font-weight:700; color:var(--muted); text-transform:uppercase;
            letter-spacing:.05em; margin:10px 0 2px; }

  /* ---- mobile (and short landscape viewports) ---- */
  @media (max-width:640px), (max-height:430px){
    .topbar { gap:10px; padding:0 12px; }
    .topbar .gen { display:none; }
    .ctl-card { top:56px; left:8px; right:8px; width:auto; max-width:none; }
    .chips { flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; }
    .chips::-webkit-scrollbar { display:none; }
    .chip { flex:0 0 auto; }
    .mgroups { max-height:34vh; }
    .mrow { min-height:40px; }
    .legend-card { bottom:12px; left:8px; }
    .panel { top:auto; left:0; right:0; bottom:0; width:auto; border-radius:14px 14px 0 0;
             max-height:45vh; max-height:45dvh; transform:translateY(100%); }
    .panel.open { transform:translateY(0); }
    body.panel-open .legend-card { display:none; }
  }
</style>
</head>
<body>
  <div class="topbar">
    <a href="index.html">← Dashboard</a>
    <h1>National map</h1>
    <button id="resetBtn" class="reset">↺ US view</button>
    <span class="gen">Updated {{ generated }}</span>
  </div>

  <div id="map"></div>
  <div class="veil" id="veil"></div>

  <div class="ctl-card">
    <div class="searchwrap">
      <input id="searchBox" type="text" placeholder="Search county or ZIP…"
             autocomplete="off" spellcheck="false" aria-label="Search county or ZIP">
      <ul class="sresults" id="searchResults" hidden></ul>
    </div>
    <div class="chips" id="chips" hidden></div>
    <div class="mgroups" id="mgroups"></div>
  </div>

  <div class="legend-card" id="legendCard">
    <div class="lhead">
      <span class="lt" id="legendTitle"></span>
      <span class="ltag" id="legendTag"></span>
      <button class="ibtn" id="infoBtn" title="About this map">ⓘ</button>
    </div>
    <div class="ldesc" id="legendDesc"></div>
    <div class="lrow">
      <span class="lv" id="legendLo"></span>
      <span class="lbar" id="legendBar">
        <span class="ltick" id="legendTick"></span>
        <span class="lzones" id="legendZones" title="Click to show only part of the range"></span>
      </span>
      <span class="lv" id="legendHi"></span>
    </div>
    <div class="lfoot">
      <span class="lna"><i></i> No data</span>
      <button class="rchip" id="rangeChip" hidden>Showing selected range ✕</button>
    </div>
    <div class="infopop" id="infopop" hidden>
      Updated {{ generated }}. Coverage: home value {{ coverage.home_value }}/{{ coverage.total }}
      counties, rent {{ coverage.rent }}, income {{ coverage.income }}.
      Your tracked markets ({{ tracked | join(', ') }}) are outlined in black.
      Zoom into a tracked state for ZIP-level detail. Gray = no public data for that metric.
      Sources: Zillow Research (values, rents, forecast) · Housing data: Realtor.com®
      Economic Research · Sale data: Redfin, a national real estate brokerage ·
      Census ACS 5-year &amp; Population Estimates · IRS SOI migration.
      Public data; the 1-yr forecast is Zillow's, everything else is measured, not predicted.
    </div>
  </div>

  <div class="panel" id="panel">
    <div class="phead">
      <div>
        <h2 id="panelName"></h2>
        <span class="badge" id="panelBadge" hidden>TRACKED</span>
      </div>
      <button class="pclose" id="panelClose" title="Close">✕</button>
    </div>
    <div class="prows" id="panelRows"></div>
    <div class="pactions">
      <button class="pbtn primary" id="zoomHereBtn">Zoom here</button>
      <button class="pbtn" id="zipDetailBtn" hidden>ZIP detail →</button>
    </div>
  </div>

  <div class="coach" id="coach">👆 Click or tap any county for local prices</div>

<script>
const METRICS = {{ metrics_json | safe }};
const LANDLORD = {{ landlord_json | default('{}') | safe }};  // state -> 0-10 score
const HAS_ZIPS = {{ 'true' if zip_states else 'false' }};
const ZIP_STATES = {{ zip_states | map(attribute='code') | list | tojson }};
const byKey = {}; METRICS.forEach(m => byKey[m.key] = m);
let currentKey = METRICS[0].key, firstSymbolId = null;
let map = null, dragging = false, rangeIdx = null, hoverRef = null, pending = null;
let sel = { props:null, isZip:false, bounds:null, cname:'' };

const US_BOUNDS = [[-125.0, 24.2], [-66.5, 49.5]];
const easeOutCubic = t => 1 - Math.pow(1 - t, 3);
const CAN_HOVER = window.matchMedia && window.matchMedia('(hover: hover)').matches;

const $ = id => document.getElementById(id);
const panel = $('panel'), sresults = $('searchResults'), searchBox = $('searchBox');
const infopop = $('infopop'), coach = $('coach'), tick = $('legendTick');

// One shared formatter: per-call toLocaleString() rebuilds Intl.NumberFormat and
// makes 6k-label rebuilds ~10x slower ('en-US' matches the Python-rendered legend).
const NF = new Intl.NumberFormat('en-US');
function fmt(kind, v){
  if(v === null || v === undefined || isNaN(v)) return 'n/a';
  if(kind === 'usd') return '$' + NF.format(Math.round(v));
  if(kind === 'usd_mo') return '$' + NF.format(Math.round(v)) + '/mo';
  if(kind === 'pct') return (v >= 0 ? '+' : '') + v.toFixed(1) + '%';
  if(kind === 'pct1') return v.toFixed(1) + '%';
  if(kind === 'pct2') return (v >= 0 ? '+' : '') + v.toFixed(2) + '%';
  if(kind === 'ratio') return v.toFixed(1) + 'x';
  if(kind === 'count') return NF.format(Math.round(v));
  if(kind === 'per1k') return (v >= 0 ? '+' : '') + v.toFixed(1) + '/1k';
  if(kind === 'days') return NF.format(Math.round(v)) + ' days';
  if(kind === 'usd_s') return (v >= 0 ? '+$' : '-$') + NF.format(Math.abs(Math.round(v)));
  if(kind === 'mos') return v.toFixed(1) + ' mo';
  if(kind === 'pct2u') return v.toFixed(2) + '%';
  if(kind === 'idx') return v.toFixed(2) + 'x US';
  if(kind === 'score') return Math.round(v) + '/10';
  if(kind === 'per1ku') return NF.format(Math.round(v)) + '/1k';
  return v;
}
const GROUPS = [];
METRICS.forEach(m => { if(GROUPS.indexOf(m.group) < 0) GROUPS.push(m.group); });
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

/* ---------- legend (county scale at national zoom, ZIP scale when drilled in) ---------- */
function zipLegendActive(){
  const m = byKey[currentKey];
  if(m.zip_only) return true;
  if(!(HAS_ZIPS && m.zlegend && map && map.getZoom && map.getZoom() > 6.6)) return false;
  // Only claim the ZIP scale when ZIP polygons are actually on screen —
  // zoomed into an untracked state, the visible fills are county-scale.
  try {
    return !!map.getLayer('zips-fill') &&
           map.queryRenderedFeatures({ layers: ['zips-fill'] }).length > 0;
  } catch(e){ return false; }
}
function legendVariant(){
  const m = byKey[currentKey];
  if(m.zip_only)
    return { L: m.legend, lo: m.zmin, hi: m.zmax, tag: 'ZIP scale' };
  return zipLegendActive()
    ? { L: m.zlegend, lo: m.zzmin, hi: m.zzmax, tag: 'ZIP scale' }
    : { L: m.legend, lo: m.zmin, hi: m.zmax, tag: (HAS_ZIPS && m.zlegend) ? 'county scale' : '' };
}
function setLegend(key){
  const m = byKey[key], v = legendVariant();
  $('legendTitle').textContent = m.label;
  $('legendTag').textContent = v.tag;
  $('legendDesc').textContent = m.desc || '';
  $('legendBar').style.background = 'linear-gradient(to right,' + v.L.colors.join(',') + ')';
  $('legendLo').textContent = v.L.lo;
  $('legendHi').textContent = v.L.hi;
  hideTick();
}
function showTick(v){
  // The bar's colors sit at QUANTILE stops, so place the tick piecewise between
  // the quartile edges (falls back to linear when qs are unavailable).
  const lv = legendVariant();
  const qs = (lv.L || {}).qs;
  let frac;
  if(qs && qs.length === 5){
    if(v <= qs[0]) frac = 0;
    else if(v >= qs[4]) frac = 1;
    else {
      for(let i = 0; i < 4; i++){
        if(v >= qs[i] && v <= qs[i + 1]){
          const span = qs[i + 1] - qs[i];
          frac = (i + (span > 0 ? (v - qs[i]) / span : 0)) / 4;
          break;
        }
      }
    }
  }
  if(frac === undefined){
    const span = (lv.hi - lv.lo) || 1;
    frac = Math.max(0, Math.min(1, (v - lv.lo) / span));
  }
  tick.style.left = (100 * frac) + '%';
  tick.style.display = 'block';
}
function hideTick(){ tick.style.display = 'none'; }

/* ---------- fill-opacity expressions (hover + cross-fade + range filter) ---------- */
function countiesFillOpacity(cond){
  const full = ['case', ['boolean', ['feature-state', 'hover'], false], 0.88, 0.72];
  return cond ? ['case', cond, full, 0.12] : full;
}
function zipsFillOpacity(cond){
  const full = ['case', ['boolean', ['feature-state', 'hover'], false], 0.95, 0.82];
  const out = cond ? ['case', cond, full, 0.12] : full;
  return ['interpolate', ['linear'], ['zoom'], 5.6, 0, 6.6, out];
}
function repaintOpacity(ccond, zcond){
  if(!map || !map.getLayer('counties-fill')) return;
  map.setPaintProperty('counties-fill', 'fill-opacity', countiesFillOpacity(ccond));
  // County-only metrics (no zexpr): hide the ZIP layer entirely, otherwise it
  // covers real county data with an opaque gray "no data" blanket.
  if(map.getLayer('zips-fill'))
    map.setPaintProperty('zips-fill', 'fill-opacity',
      byKey[currentKey].zexpr ? zipsFillOpacity(zcond || ccond) : 0);
}

/* ---------- legend range filter ---------- */
function zoneEls(){ return Array.prototype.slice.call($('legendZones').children); }
function rangeCond(qs, i){
  // Outer zones are open-ended so the extreme ~2% beyond the color-ramp stops stay lit.
  if(!qs || qs.length !== 5) return null;
  const cond = ['all', ['has', currentKey]];
  if(i > 0) cond.push(['>=', ['get', currentKey], qs[i]]);
  if(i < 3) cond.push(['<=', ['get', currentKey], qs[i + 1]]);
  return cond;
}
function applyRange(i){
  const m = byKey[currentKey];
  const ccond = rangeCond((m.legend || {}).qs, i);
  if(!ccond) return;
  if(rangeIdx === i){ clearRange(true); return; }
  rangeIdx = i;
  // Each layer filters by its own distribution's quartiles (county vs ZIP scale).
  const zcond = rangeCond((m.zlegend || m.legend || {}).qs, i) || ccond;
  repaintOpacity(ccond, zcond);
  $('rangeChip').hidden = false;
  zoneEls().forEach((z, j) => z.classList.toggle('on', j === i));
}
function clearRange(repaint){
  rangeIdx = null;
  $('rangeChip').hidden = true;
  zoneEls().forEach(z => z.classList.remove('on'));
  if(repaint) repaintOpacity(null);
}
(function initZones(){
  const wrap = $('legendZones');
  for(let i = 0; i < 4; i++){
    const z = document.createElement('button');
    z.type = 'button';
    z.setAttribute('aria-label', 'Show only quarter ' + (i + 1) + ' of the value range');
    z.addEventListener('click', () => applyRange(i));
    wrap.appendChild(z);
  }
})();
$('rangeChip').addEventListener('click', () => clearRange(true));

/* ---------- metric switching + grouped selector ---------- */
function setMetric(btn){
  document.querySelectorAll('.mrow').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  currentKey = btn.dataset.key;
  clearRange(true);
  setLegend(currentKey);
  const m = byKey[currentKey];
  if(map && map.getLayer('counties-fill')){
    map.setPaintProperty('counties-fill', 'fill-color', m.expr);
    if(map.getLayer('zips-fill'))
      map.setPaintProperty('zips-fill', 'fill-color', m.zexpr || m.expr);
  }
  refreshLabels();
  if(sel.props) renderPanelRows();
  if(window.matchMedia(MOBILE_MQ).matches)
    document.querySelectorAll('.mgroup').forEach(g => g.classList.add('closed'));
}
(function buildSelector(){
  const wrap = $('mgroups');
  GROUPS.forEach((gname, gi) => {
    const g = document.createElement('div');
    g.className = 'mgroup' + (gi === 0 ? '' : ' closed');
    const h = document.createElement('button');
    h.type = 'button'; h.className = 'mghead';
    h.innerHTML = esc(gname) + '<span class="car">▾</span>';
    h.addEventListener('click', () => {
      const wasClosed = g.classList.contains('closed');
      document.querySelectorAll('.mgroup').forEach(x => x.classList.add('closed'));
      if(wasClosed) g.classList.remove('closed');   // accordion: one group open at a time
    });
    g.appendChild(h);
    const list = document.createElement('div');
    list.className = 'mglist';
    METRICS.filter(m => m.group === gname).forEach(m => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mrow' + (m.key === currentKey ? ' active' : '');
      b.dataset.key = m.key;
      b.title = m.desc || '';
      b.innerHTML = '<span class="dot"></span>' + esc(m.label);
      b.addEventListener('click', () => setMetric(b));
      list.appendChild(b);
    });
