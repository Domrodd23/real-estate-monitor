/* ---------- stats panel ---------- */
function percentile(m, v){
  const q = m.q || [];
  if(q.length !== 21 || v === null || isNaN(v)) return null;
  if(v <= q[0]) return 0;
  if(v >= q[20]) return 100;
  for(let i = 0; i < 20; i++){
    if(v >= q[i] && v <= q[i + 1]){
      const span = q[i + 1] - q[i];
      return 5 * (i + (span > 0 ? (v - q[i]) / span : 0));
    }
  }
  return null;
}
function renderPanelRows(){
  let html = '';
  GROUPS.forEach(gname => {
    let rows = '';
    METRICS.filter(m => m.group === gname).forEach(m => {
      const raw = sel.props[m.key];
      if(raw === undefined || raw === null || raw === '') return;
      const v = +raw;
      if(isNaN(v)) return;
      const pct = sel.isZip ? null : percentile(m, v);
      rows += '<div class="prow' + (m.key === currentKey ? ' active' : '') + '">' +
              '<span class="plabel">' + esc(m.label) + '</span>' +
              '<span class="pval">' + fmt(m.fmt, v) + '</span>' +
              (pct !== null ? '<span class="ppct">higher than ' + Math.round(pct) +
               '% of US counties</span>' : '') +
              '</div>';
    });
    // ZIP features don't carry the (state-level) landlord score — look it up.
    if(gname === 'Taxes & policy' && sel.isZip){
      const g = GEO.find(x => x.t === 'z' && x.n === sel.cname);
      const sc = g && g.s ? LANDLORD[g.s.toUpperCase()] : undefined;
      if(sc !== undefined)
        rows += '<div class="prow"><span class="plabel">Landlord friendliness (state)</span>' +
                '<span class="pval">' + fmt('score', sc) + '</span></div>';
    }
    if(rows) html += '<div class="pgroup">' + esc(gname) + '</div>' + rows;
  });
  $('panelRows').innerHTML = html ||
    '<div class="prow"><span class="plabel">No public data for this area.</span></div>';
}
function showZipBtn(){
  if(!HAS_ZIPS || sel.isZip || !sel.cname || sel.cname.length < 4) return false;
  const st = sel.cname.slice(-2).toLowerCase();
  return sel.cname.charAt(sel.cname.length - 3) === ' ' && ZIP_STATES.indexOf(st) >= 0;
}
const NO_MATCH = '__none__';  // no-data counties carry cname:'', so '' must never be the filter
function setSelFilters(cname, isZip){
  if(!map) return;
  if(map.getLayer('sel-county-line'))
    map.setFilter('sel-county-line', ['==', ['get', 'cname'], isZip ? NO_MATCH : (cname || NO_MATCH)]);
  if(map.getLayer('sel-zip-line'))
    map.setFilter('sel-zip-line', ['==', ['get', 'cname'], isZip ? (cname || NO_MATCH) : NO_MATCH]);
}
function indexBounds(cname, isZip){
  // Authoritative full bbox from the search index — queryRenderedFeatures returns
  // tile-clipped fragments, so fragment bounds under-frame counties on tile edges.
  const t = isZip ? 'z' : 'c';
  const g = GEO.find(x => x.t === t && x.n === cname);
  return (g && g.b) ? [[g.b[0], g.b[1]], [g.b[2], g.b[3]]] : null;
}
function selectFeature(f, boundsOverride){
  const isZip = f.sourceLayer === 'zips' || f.source === 'zips';
  sel = { props: f.properties, isZip: isZip, cname: f.properties.cname,
          bounds: boundsOverride || indexBounds(f.properties.cname, isZip) ||
                  geometryBounds(f.geometry) };
  setSelFilters(sel.cname, isZip);
  $('panelName').textContent = sel.cname;
  $('panelBadge').hidden = !(sel.props.tracked === true || sel.props.tracked === 'true');
