/* ---------- camera ---------- */
const MOBILE_MQ = '(max-width:640px), (max-height:430px)';
function flyToBounds(b, maxZoom){
  // When the bottom sheet is open, pad the bottom so the target isn't hidden under it.
  const sheet = (window.matchMedia(MOBILE_MQ).matches && panel.classList.contains('open'))
    ? panel.getBoundingClientRect().height : 0;
  const pad = sheet ? { top: 60, left: 30, right: 30, bottom: 30 + sheet } : 60;
  let d = 900;
  try {
    const cam = map.cameraForBounds(b, { padding: pad });
    if(cam) d = Math.min(2200, 500 + 350 * Math.abs(cam.zoom - map.getZoom()));
  } catch(e){}
  map.fitBounds(b, { padding: pad, maxZoom: maxZoom || 12, duration: d,
                     easing: easeOutCubic, essential: true });
}
function resetView(){
  pending = null;  // cancel any in-flight search selection — this is a user cancel
  map.fitBounds(US_BOUNDS, { padding: 20, duration: 900, easing: easeOutCubic });
}

function geometryBounds(geom){
  let minX = 180, minY = 90, maxX = -180, maxY = -90;
  const visit = c => {
    if(typeof c[0] === 'number'){
      minX = Math.min(minX, c[0]); maxX = Math.max(maxX, c[0]);
      minY = Math.min(minY, c[1]); maxY = Math.max(maxY, c[1]);
    } else c.forEach(visit);
  };
  try { visit(geom.coordinates); } catch(e){ return null; }
  return [[minX, minY], [maxX, maxY]];
}

/* ---------- hover ---------- */
function layerPref(){
  const out = [];
  if(map.getLayer('zips-fill')) out.push('zips-fill');
  if(map.getLayer('counties-fill')) out.push('counties-fill');
  return out;
}
function pickFeature(feats){
  const zf = feats.find(f => f.layer.id === 'zips-fill');
  const cf = feats.find(f => f.layer.id === 'counties-fill');
  // County-only metric: the ZIP layer is invisible, so hover/click the county.
  if(!byKey[currentKey].zexpr) return cf || zf;
  return (map.getZoom() > 6.3 && zf) ? zf : (cf || zf);
}
const tipPopup = new maplibregl.Popup({ closeButton:false, closeOnClick:false, offset:8 });
function clearHover(){
  if(hoverRef){ try { map.setFeatureState(hoverRef, { hover:false }); } catch(e){} hoverRef = null; }
  tipPopup.remove();
  hideTick();
}
function onHoverMove(e){
  if(dragging) return;
  const layers = layerPref();
  if(!layers.length) return;
  const f = pickFeature(map.queryRenderedFeatures(e.point, { layers: layers }));
  if(!f || !f.properties.cname){
    clearHover();
    map.getCanvas().style.cursor = 'grab';
    return;
  }
  map.getCanvas().style.cursor = 'pointer';
  const ref = { source: f.source, sourceLayer: f.sourceLayer, id: f.id };
  if(!hoverRef || hoverRef.id !== ref.id || hoverRef.source !== ref.source){
    if(hoverRef){ try { map.setFeatureState(hoverRef, { hover:false }); } catch(e){} }
    try { map.setFeatureState(ref, { hover:true }); } catch(e){}
    hoverRef = ref;
  }
  const m = byKey[currentKey], v = f.properties[m.key];
  tipPopup.setLngLat(e.lngLat).setHTML(tipHTML(f.properties)).addTo(map);
  if(v !== undefined && v !== null && !isNaN(v)) showTick(+v);
  else hideTick();
}
const INVESTOR_KEYS = ['cap_rate', 'gross_yield', 'price_to_rent', 'rent'];
const HEAT_KEYS = ['days_on_market', 'price_cut_share', 'inventory_yoy'];
function tipHTML(p){
  const m = byKey[currentKey];
  let h = '<strong>' + esc(p.cname) + '</strong>';
  if(currentKey === 'sec8_premium' && p.safmr_2br > 0 && p.rent > 0){
    const rows = [
      ['Voucher ceiling (2-bed)', fmt('usd_mo', p.safmr_2br)],
      ['Voucher ceiling (3-bed)', p.safmr_3br > 0 ? fmt('usd_mo', p.safmr_3br) : 'n/a'],
      ['Market rent (ZORI)', fmt('usd_mo', p.rent)],
      ['Premium (2-bed)', fmt('pct', p.sec8_premium)]];
    return h + '<div class="tiprows">' +
      rows.map(r => '<span>' + esc(r[0]) + '</span><b>' + r[1] + '</b>').join('') +
      '</div><div class="tipmore">Ceilings include utilities · Click for all metrics</div>';
  }
  if(HEAT_KEYS.indexOf(currentKey) >= 0){
    const rows = [[m.label, fmt(m.fmt, p[m.key])]];
    HEAT_KEYS.forEach(k => {
      if(k !== currentKey && p[k] !== undefined && p[k] !== null)
        rows.push([byKey[k].label, fmt(byKey[k].fmt, p[k])]);
    });
    h += '<div class="tiprows">' +
         rows.map(r => '<span>' + esc(r[0]) + '</span><b>' + r[1] + '</b>').join('') +
         '</div>';
    if(p.listings !== undefined && p.listings !== null)
      h += '<div class="tipmore">Based on ' + NF.format(Math.round(p.listings)) +
           ' active listings</div>';
    return h + '<div class="tipmore">Click for all metrics</div>';
  }
  if(INVESTOR_KEYS.indexOf(currentKey) >= 0 && p.rent > 0 && p.home_value > 0){
    // Reventure-style investor breakdown
    const gross = Math.round(p.rent * 12);
    const rows = [[m.label, fmt(m.fmt, p[m.key])],
                  ['Gross rent income', fmt('usd', gross) + '/yr']];
    if(p.exp_est !== undefined && p.exp_est !== null){
      rows.push(['Expenses (est.)', fmt('usd', p.exp_est) + '/yr']);
      rows.push(['Net rent income', fmt('usd', gross - p.exp_est) + '/yr']);
    }
    rows.push(['Home value', fmt('usd', p.home_value)]);
    h += '<div class="tiprows">' +
         rows.map(r => '<span>' + esc(r[0]) + '</span><b>' + r[1] + '</b>').join('') +
         '</div>';
  } else {
    h += '<br>' + esc(m.label) + ': ' + fmt(m.fmt, p[m.key]);
  }
  return h + '<div class="tipmore">Click for all metrics</div>';
}

/* ---------- on-map value labels (Reventure-style "43606 · 5.7%") ---------- */
function shortName(g){
  if(g.t === 'z') return g.n.slice(4);            // "ZIP 43606" -> "43606"
  const i = g.n.lastIndexOf(',');                 // "Lucas County, OH" -> "Lucas County"
  return i > 0 ? g.n.slice(0, i) : g.n;
}
function labelFeatures(){
  const feats = [];
  // County-only metric: skip ZIP labels and keep county labels at every zoom
  // (zs:false routes them to the layer without a maxzoom).
  const countyOnly = !byKey[currentKey].zexpr && !byKey[currentKey].zip_only;
  for(const g of GEO){
    if((g.t !== 'c' && g.t !== 'z') || !g.c) continue;
    if(countyOnly && g.t === 'z') continue;
    const v = (g.v || {})[currentKey];
    const st = g.t === 'c' ? g.n.slice(-2).toLowerCase() : '';
    feats.push({ type:'Feature', geometry:{ type:'Point', coordinates:g.c },
      properties:{ t: g.t,
        zs: !countyOnly && g.t === 'c' && ZIP_STATES.indexOf(st) >= 0,
        label: shortName(g) +
          (v !== undefined && v !== null ? '\n' + fmt(byKey[currentKey].fmt, v) : '') } });
  }
  return { type:'FeatureCollection', features: feats };
}
function ensureLabels(){
  if(!map || !GEO.length || !map.getLayer('counties-fill') || map.getSource('labels')) return;
  let fontStack = null, fallbackStack = null;
  try {
    for(const l of map.getStyle().layers){
      if(l.type === 'symbol' && l.layout && l.layout['text-font']){
        const f = l.layout['text-font'];
        if(!Array.isArray(f)) continue;
        if(!/italic/i.test(f.join(' '))){ fontStack = f; break; }  // upright, not water-label italics
        if(!fallbackStack) fallbackStack = f;
      }
    }
  } catch(e){}
  fontStack = fontStack || fallbackStack || ['Noto Sans Regular'];
  map.addSource('labels', { type:'geojson', data: labelFeatures() });
  const base = {
    type:'symbol', source:'labels',
    layout:{ 'text-field':['get','label'], 'text-font':fontStack,
             'text-size':['interpolate', ['linear'], ['zoom'], 5, 10, 9, 13],
             'text-line-height':1.2, 'text-padding':4, 'text-max-width':10 },
    paint:{ 'text-color':'#1b1f23', 'text-halo-color':'rgba(255,255,255,0.92)',
            'text-halo-width':1.4 }
  };
  // County labels hide where ZIP labels take over (tracked states only).
  map.addLayer(Object.assign({}, base, { id:'labels-county', minzoom:5,
    filter:['all', ['==', ['get','t'], 'c'], ['!=', ['get','zs'], true]] }));
  // Handoff at 6.6 — the exact zoom where zips-fill reaches full opacity and the
  // legend flips to the ZIP scale, so printed values always match the fills.
  map.addLayer(Object.assign({}, base, { id:'labels-county-zs', minzoom:5, maxzoom:6.6,
    filter:['all', ['==', ['get','t'], 'c'], ['==', ['get','zs'], true]] }));
  map.addLayer(Object.assign({}, base, { id:'labels-zip', minzoom:6.6,
    filter:['==', ['get','t'], 'z'] }));
}
function refreshLabels(){
  const src = map && map.getStyle() && map.getSource('labels');
  if(src) src.setData(labelFeatures());
}

/* ---------- search ---------- */
let GEO = [], results = [], activeIdx = -1;
// DATA_V busts browser caches after each rebuild — cached byte-range responses
// from an older tile file otherwise corrupt reads against the new one.
const DATA_V = '{{ generated | replace(" ", "") | replace("-", "") | replace(":", "") }}';
fetch('geo_index.json?v=' + DATA_V)
  .then(r => r.ok ? r.json() : [])
  .then(d => { GEO = d || []; renderChips(); ensureLabels(); })
  .catch(() => {});
function renderChips(){
  const aliases = GEO.filter(g => g.t === 'a');
  const wrap = $('chips');
  wrap.innerHTML = '';
  aliases.forEach(a => {
    const b = document.createElement('button');
    b.className = 'chip';
    b.textContent = a.n;
    b.addEventListener('click', () => chooseEntry(a));
    wrap.appendChild(b);
  });
  wrap.hidden = !aliases.length;
}
function searchScore(g, q){
  if(/^\d+$/.test(q))
    return (g.t === 'z' && g.n.slice(4).indexOf(q) === 0) ? 3 : 0;
  const name = g.n.toLowerCase();
  if(name.indexOf(q) === 0 || name.replace(' county,', ',').indexOf(q) === 0) return 3;
  if(name.split(/[\s,]+/).some(w => w.indexOf(q) === 0)) return 2;
  if(name.indexOf(q) >= 0) return 1;
  return 0;
}
function hideResults(){ sresults.hidden = true; results = []; activeIdx = -1; }
function paintActive(){
  Array.prototype.forEach.call(sresults.children, (li, i) =>
    li.classList.toggle('active', i === activeIdx));
}
function renderResults(){
  if(!results.length){ hideResults(); return; }
  activeIdx = 0;
  sresults.innerHTML = results.map((g, i) => {
    const sub = g.t === 'z' ? (g.s || '') : (g.t === 'a' ? 'your market' : '');
    return '<li data-i="' + i + '"' + (i === 0 ? ' class="active"' : '') + '>' +
           '<span>' + esc(g.n) + '</span>' +
           (sub ? '<span class="sub">' + esc(sub) + '</span>' : '') + '</li>';
  }).join('');
  sresults.hidden = false;
}
searchBox.addEventListener('input', () => {
  const q = searchBox.value.trim().toLowerCase();
  if(q.length < 2){ hideResults(); return; }
  const scored = [];
  for(const g of GEO){
    const s = searchScore(g, q);
    if(s > 0) scored.push([s, g]);
  }
  scored.sort((a, b) => b[0] - a[0] || a[1].n.localeCompare(b[1].n));
  results = scored.slice(0, 8).map(r => r[1]);
  renderResults();
});
searchBox.addEventListener('keydown', e => {
  if(sresults.hidden || !results.length) return;
  if(e.key === 'ArrowDown'){ e.preventDefault(); activeIdx = (activeIdx + 1) % results.length; paintActive(); }
  else if(e.key === 'ArrowUp'){ e.preventDefault(); activeIdx = (activeIdx - 1 + results.length) % results.length; paintActive(); }
  else if(e.key === 'Enter'){ e.preventDefault(); if(results[activeIdx]) chooseEntry(results[activeIdx]); }
});
searchBox.addEventListener('blur', () => setTimeout(hideResults, 150));
sresults.addEventListener('mousedown', e => {
  const li = e.target.closest('li');
  if(!li) return;
  e.preventDefault();
  chooseEntry(results[+li.dataset.i]);
});
function chooseEntry(g){
  hideResults();
  searchBox.value = g.n;
  searchBox.blur();
  if(!map || !g.b) return;
  const isZip = g.t === 'z';
  const cname = g.cname || g.n;
  const bounds = [[g.b[0], g.b[1]], [g.b[2], g.b[3]]];
  setSelFilters(cname, isZip);
  flyToBounds(bounds, isZip ? 12 : 9);
  pending = { cname: cname, isZip: isZip, bounds: bounds, tries: 3 };
  map.once('idle', resolvePending);
}
function resolvePending(){
  if(!pending) return;
  const src = pending.isZip ? 'zips' : 'counties';
  let feats = [];
  try {
    feats = map.querySourceFeatures(src, {
      sourceLayer: src, filter: ['==', ['get', 'cname'], pending.cname] });
  } catch(e){}
  if(feats.length){
    selectFeature({ properties: feats[0].properties, geometry: feats[0].geometry,
                    source: src, sourceLayer: src }, pending.bounds);
    pending = null;
  } else if(--pending.tries > 0){
    map.once('idle', resolvePending);
  } else {
    pending = null;
  }
}

