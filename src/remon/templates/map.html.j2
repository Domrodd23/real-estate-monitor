/* ---------- map ---------- */
maplibregl.addProtocol('pmtiles', new pmtiles.Protocol().tile);

function addLayers(){
  if(map.getLayer('counties-fill')) return;
  for(const l of map.getStyle().layers){ if(l.type === 'symbol'){ firstSymbolId = l.id; break; } }

  map.addSource('counties', { type:'vector', url:'pmtiles://counties.pmtiles?v=' + DATA_V, promoteId:'cname' });
  map.addLayer({ id:'counties-fill', type:'fill', source:'counties', 'source-layer':'counties',
    paint:{ 'fill-color': byKey[currentKey].expr,
            'fill-opacity': countiesFillOpacity(null) } }, firstSymbolId);
  map.addLayer({ id:'counties-line', type:'line', source:'counties', 'source-layer':'counties',
    paint:{ 'line-color': ['case', ['boolean', ['feature-state', 'hover'], false],
                           '#1b1f23', 'rgba(90,100,110,0.25)'],
            'line-width': ['case', ['boolean', ['feature-state', 'hover'], false], 2, 0.3] } },
    firstSymbolId);

  if(HAS_ZIPS){
    map.addSource('zips', { type:'vector', url:'pmtiles://zips.pmtiles?v=' + DATA_V, promoteId:'cname' });
    map.addLayer({ id:'zips-fill', type:'fill', source:'zips', 'source-layer':'zips', minzoom:5.5,
      paint:{ 'fill-color': byKey[currentKey].zexpr || byKey[currentKey].expr,
              'fill-opacity': byKey[currentKey].zexpr ? zipsFillOpacity(null) : 0 } },
      firstSymbolId);
    map.addLayer({ id:'zips-line', type:'line', source:'zips', 'source-layer':'zips', minzoom:5.5,
      paint:{ 'line-color':'rgba(70,80,90,0.4)',
              'line-opacity': ['interpolate', ['linear'], ['zoom'], 5.8, 0, 6.8, 0.4],
              'line-width': ['interpolate', ['linear'], ['zoom'], 6, 0.3, 10, 0.9] } },
      firstSymbolId);
  }

  // tracked counties outlined on top, selection outlines above everything
  map.addLayer({ id:'tracked-line', type:'line', source:'counties', 'source-layer':'counties',
    filter:['==', ['get','tracked'], true], paint:{ 'line-color':'#111', 'line-width':2 } });
  map.addLayer({ id:'sel-county-line', type:'line', source:'counties', 'source-layer':'counties',
    filter:['==', ['get','cname'], NO_MATCH],
    paint:{ 'line-color':'#1f6feb', 'line-width':2.5 } });
  if(HAS_ZIPS){
    map.addLayer({ id:'sel-zip-line', type:'line', source:'zips', 'source-layer':'zips',
      filter:['==', ['get','cname'], NO_MATCH],
      paint:{ 'line-color':'#1f6feb', 'line-width':2.5 } });
  }

  // Repaint as tiles stream in (keeps the map responsive even if rAF is sluggish).
  map.on('sourcedata', e => { if(e.isSourceLoaded) map.triggerRepaint(); });
  ensureLabels();
  map.resize();
}

try {
  map = new maplibregl.Map({
    container: 'map',
    style: 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json',
    bounds: US_BOUNDS, fitBoundsOptions: { padding: 20 },
    maxZoom: 13, minZoom: 2, dragRotate: false,
    maxBounds: [[-190, 8], [-45, 75]] });
  map.addControl(new maplibregl.NavigationControl({ showCompass:false }), 'bottom-right');
  map.scrollZoom.setWheelZoomRate(1 / 600);
  map.touchZoomRotate.disableRotation();

  map.on('load', addLayers);
  // Both the 'load' event AND isStyleLoaded() are unreliable with some vector
  // styles, so keep attempting to add the data layers until it sticks
  // (addLayer throws while the style is still loading; that's the retry signal).
  const _iv = setInterval(() => {
    try { addLayers(); } catch(e){}
    if(map.getLayer('counties-fill')) clearInterval(_iv);
  }, 250);
  setTimeout(() => clearInterval(_iv), 60000);

  map.once('idle', dropVeil);
  // Some environments stall the initial render loop entirely (blank canvas, no
  // 'idle'). Kick resize+repaint until the first idle, then stop — bounded, so
  // it can't burn battery like an unconditional timer would.
  let _awake = false;
  map.once('idle', () => { _awake = true; });
  const _kick = setInterval(() => {
    if(_awake){ clearInterval(_kick); return; }
    try { map.resize(); map.triggerRepaint(); } catch(e){}
  }, 400);
  setTimeout(() => clearInterval(_kick), 8000);
  // Re-render the legend when the county↔ZIP scale changes. The check is
  // viewport-dependent (are ZIP polygons on screen?), so sync on pan too.
  let legendLevel = null;
  const syncLegend = () => {
    const lvl = zipLegendActive() ? 'z' : 'c';
    if(lvl !== legendLevel){ legendLevel = lvl; setLegend(currentKey); }
  };
  // zoomend (not zoom): the check queries rendered features, too heavy per-frame.
  map.on('zoomend', syncLegend);
  map.on('moveend', syncLegend);
  map.on('idle', syncLegend);  // tiles can finish streaming after moveend
  map.getCanvas().style.cursor = 'grab';
  map.on('dragstart', () => { dragging = true; map.getCanvas().style.cursor = 'grabbing'; });
  map.on('dragend', () => { dragging = false; map.getCanvas().style.cursor = 'grab'; });
  window.addEventListener('resize', () => map.resize());

  if(CAN_HOVER){
    map.on('mousemove', onHoverMove);
    map.getCanvas().addEventListener('mouseleave', () => {
      clearHover();
      map.getCanvas().style.cursor = 'grab';
    });
  }

  map.on('click', e => {
    dismissCoach();
    infopop.hidden = true;
    pending = null;
    const layers = layerPref();
    const f = layers.length ? pickFeature(map.queryRenderedFeatures(e.point, { layers: layers })) : null;
    if(!f || !f.properties.cname){ closePanel(); return; }
    selectFeature(f);
  });

  $('resetBtn').addEventListener('click', () => { infopop.hidden = true; resetView(); });
  document.addEventListener('keydown', e => {
    if(e.key !== 'Escape') return;
    if(!sresults.hidden){ hideResults(); return; }
    if(!infopop.hidden){ infopop.hidden = true; return; }
    if(panel.classList.contains('open')){ closePanel(); return; }
    resetView();
  });
} catch(e){
  dropVeil();
  $('map').innerHTML =
    '<p style="padding:24px;color:#5b6670">The map could not load. Please refresh the page.</p>';
}
</script>
</body>
</html>
